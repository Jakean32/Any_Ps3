<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.anyps3.app"
    android:versionCode="3"
    android:versionName="0.3.0">

    <!-- Any_Ps3 works fully offline. NO INTERNET PERMISSION. -->
    <!-- Games are read via SAF (no copy). Cache write uses either the
         user-picked folder (when All-Files-Access granted / legacy storage)
         or the app's own external dir. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage"
        xmlns:tools="http://schemas.android.com/tools" />

    <uses-feature android:glEsVersion="0x00030000" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".AnyPs3App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.AnyPs3"
        android:hasFragileUserData="true">

        <activity android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AnyPs3.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".WizardActivity"
            android:exported="false"
            android:theme="@style/Theme.AnyPs3" />

        <activity android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.AnyPs3"
            android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>
</manifest>
