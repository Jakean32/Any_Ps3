<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <ListView
        android:id="@+id/log_list"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:padding="12dp"
        android:divider="@color/transparent" android:dividerHeight="2dp"
        android:stackFromBottom="true" android:transcriptMode="normal" />

    <Button
        android:id="@+id/log_clear"
        android:layout_width="wrap_content" android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="@drawable/bg_button"
        android:text="@string/logs_clear"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" android:stateListAnimator="@null" />
</FrameLayout>
