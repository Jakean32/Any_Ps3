<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom navigation -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent" android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@color/bg_dark_elev">
        <LinearLayout android:id="@+id/nav_library" style="@style/NavItem">
            <ImageView android:id="@+id/nav_library_icon" style="@style/NavIcon"
                android:src="@drawable/ic_nav_library" />
            <TextView android:id="@+id/nav_library_label" style="@style/NavLabel"
                android:text="@string/nav_library" />
        </LinearLayout>
        <LinearLayout android:id="@+id/nav_settings" style="@style/NavItem">
            <ImageView android:id="@+id/nav_settings_icon" style="@style/NavIcon"
                android:src="@drawable/ic_nav_settings" />
            <TextView android:id="@+id/nav_settings_label" style="@style/NavLabel"
                android:text="@string/nav_settings" />
        </LinearLayout>
        <LinearLayout android:id="@+id/nav_logs" style="@style/NavItem">
            <ImageView android:id="@+id/nav_logs_icon" style="@style/NavIcon"
                android:src="@drawable/ic_nav_logs" />
            <TextView android:id="@+id/nav_logs_label" style="@style/NavLabel"
                android:text="@string/nav_logs" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
