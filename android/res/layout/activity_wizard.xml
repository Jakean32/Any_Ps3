<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <ViewFlipper
        android:id="@+id/wizard_flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:inAnimation="@android:anim/fade_in"
        android:outAnimation="@android:anim/fade_out">

        <!-- Page 0: welcome -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal"
                android:padding="28dp">
                <ImageView
                    android:layout_width="140dp" android:layout_height="140dp"
                    android:layout_marginTop="28dp"
                    android:src="@drawable/logo_full"
                    android:contentDescription="@string/app_name" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/wizard_welcome_title"
                    android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/wizard_welcome_body"
                    android:textColor="@color/text_secondary" android:textSize="15sp"
                    android:lineSpacingMultiplier="1.25" />
            </LinearLayout>
        </ScrollView>

        <!-- Page 1: cache folder -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="28dp">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/wizard_folder_title"
                    android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/wizard_folder_body"
                    android:textColor="@color/text_secondary" android:textSize="15sp"
                    android:lineSpacingMultiplier="1.25" />
                <Button
                    android:id="@+id/wizard_pick_folder"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_button_accent"
                    android:text="@string/wizard_pick_folder"
                    android:textColor="@color/accent_gold_bright" android:textSize="16sp"
                    android:stateListAnimator="@null" />
                <TextView
                    android:id="@+id/wizard_free_space"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/text_secondary" android:textSize="14sp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/wizard_space_warning"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/wizard_space_warning"
                    android:textColor="@color/status_failed" android:textSize="14sp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/wizard_cache_note"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:textColor="@color/text_primary" android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/wizard_cache_restricted"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/wizard_cache_restricted"
                    android:textColor="@color/text_dim" android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <!-- Page 2: legal -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="28dp">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/wizard_legal_title"
                    android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/wizard_legal_body"
                    android:textColor="@color/text_secondary" android:textSize="15sp"
                    android:lineSpacingMultiplier="1.25" />
                <CheckBox
                    android:id="@+id/wizard_accept"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/wizard_accept"
                    android:textColor="@color/text_primary" android:textSize="15sp"
                    android:buttonTint="@color/accent_gold" />
            </LinearLayout>
        </ScrollView>
    </ViewFlipper>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="20dp"
        android:gravity="center_vertical">
        <Button
            android:id="@+id/wizard_back"
            android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:background="@drawable/bg_button"
            android:text="@string/wizard_back"
            android:textColor="@color/text_secondary" android:stateListAnimator="@null" />
        <Space android:layout_width="16dp" android:layout_height="1dp" />
        <Button
            android:id="@+id/wizard_next"
            android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:background="@drawable/bg_button_accent"
            android:text="@string/wizard_next"
            android:textColor="@color/accent_gold_bright" android:stateListAnimator="@null" />
    </LinearLayout>
</LinearLayout>
